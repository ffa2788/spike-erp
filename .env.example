# Copy to .env for local development. On Vercel, set the production values in
# the project environment. Do not set SEED_EXAMPLE or ALLOW_SEED there.
# See docs/DEPLOY.md.

# Neon pooled connection string. The running app uses this.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Neon direct connection string (host without -pooler). Migrations use this.
# Locally, set this to the same value as DATABASE_URL.
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-characters

# Authenticator step. Only the exact value true turns it on.
# REQUIRE_2FA=true

# First-run owner seed only. The running app does not read these.
# Leave OWNER_PASSWORD unset. The seed writes owner-initial-password.txt.
OWNER_EMAIL=frank@sperchemical.com
OWNER_NAME=FFA
# OWNER_PASSWORD=
# OWNER_PASSWORD_FILE=owner-initial-password.txt
COMPANY_LEGAL_NAME=SPER Chemical Corporation
COMPANY_ADDRESS=
COMPANY_CITY=Clearwater
COMPANY_STATE=FL
COMPANY_ZIP=
COMPANY_PHONE=
TREVOR_EMAIL=trevor@sperchemical.com

# Example data. Leave unset in production. Local example load:
#   ALLOW_SEED=yes SEED_EXAMPLE=yes npm run seed
# ALLOW_SEED=yes
# SEED_EXAMPLE=yes

# Amazon Selling Partner API stays off. Leave blank.
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_SELLER_ID=
AMAZON_MARKETPLACE_ID=
AMAZON_AWS_ACCESS_KEY_ID=
AMAZON_AWS_SECRET_ACCESS_KEY=

# Walmart Marketplace. Leave blank to show "Not connected".
WALMART_CLIENT_ID=
WALMART_CLIENT_SECRET=

# Mail stays log-only until SPIKE_EMAIL_FROM and SPIKE_EMAIL_PROVIDER are set.
# SPIKE_EMAIL_PROVIDER is resend, postmark, smtp, or ses.
SPIKE_EMAIL_FROM=
SPIKE_EMAIL_PROVIDER=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
SMTP_HOST=
SPIKE_SES_REGION=

# PDF browser. Vercel does not include Chrome. Leave unset there.
# CHROME_PATH=/usr/bin/google-chrome
