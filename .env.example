# Copy to .env and replace every value before real use.
# SPIKE refuses to start signing sessions without AUTH_SECRET.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/spike
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-characters

# Seed wipes the database and loads clearly labeled example data.
ALLOW_SEED=yes

# Amazon Selling Partner API. Leave blank to show "Not connected".
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_SELLER_ID=
AMAZON_MARKETPLACE_ID=
AMAZON_AWS_ACCESS_KEY_ID=
AMAZON_AWS_SECRET_ACCESS_KEY=

# Walmart Marketplace. Leave blank to show "Not connected".
WALMART_CLIENT_ID=
WALMART_CLIENT_SECRET=

# Stock alert email. Leave blank to show "Email is not configured".
# SPIKE_EMAIL_PROVIDER is resend, postmark, smtp, or ses.
SPIKE_EMAIL_FROM=
SPIKE_EMAIL_PROVIDER=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
SMTP_HOST=
SPIKE_SES_REGION=
